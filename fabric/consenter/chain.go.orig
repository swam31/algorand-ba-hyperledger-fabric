package consenter

import (
	"fmt"
	"crypto/ed25519"
	"encoding/binary"
	"encoding/json"
	"sync"
	"time"

	"github.com/hyperledger/fabric-protos-go/common"
	"github.com/golang/protobuf/proto"
	"github.com/hyperledger/fabric/orderer/consensus"
	"github.com/swayamchavan/algorand-fabric/engine/ba"
	"github.com/swayamchavan/algorand-fabric/engine/vrf"
	"github.com/swayamchavan/algorand-fabric/fabric/config"
	"github.com/swayamchavan/algorand-fabric/fabric/telemetry"
	"github.com/swayamchavan/algorand-fabric/fabric/transport"
)

// Chain implements the consensus.Chain interface for the Algorand consenter.
// It wires the Fabric ordering service to the BA* engine.
type Chain struct {
	support  consensus.ConsenterSupport
	node     *ba.Node
	inbox    *ba.Inbox
	registry *ba.Registry
	transport *transport.Transport
	telemetry *telemetry.Server

	nodeID     string
	privKey    ed25519.PrivateKey
	seedChain  *config.SeedChain
	channelID  string
	params     ba.Params

	// Channels for managing the main consensus loop
	haltChan  chan struct{}
	errorChan chan struct{}
	
	errorOnce sync.Once

	// Locks and channels for incoming transactions
	txChan         chan *common.Envelope
	configChan     chan *common.Envelope
	proposalChan   chan ProposalMsg
	wakeupChan     chan struct{}
	
	sync.Mutex
	failedRounds   uint64
	
	wg sync.WaitGroup
}

// Order accepts normal transactions from Fabric
func (c *Chain) Order(env *common.Envelope, configSeq uint64) error {
	// EXPLANATION OF ENVELOPE PATH:
	// Order() marshals the Envelope to the mesh and then explicitly pushes it into this node's txChan.
	// This makes the behavior deliberate rather than incidental.
	//
	// WHY THIS IS DANGEROUS (RISK WARNING):
	// Broadcasting envelopes and having every orderer cut its own block relies on the assumption
	// that envelopes arrive in the exact same order on every node, which makes CreateNextBlock
	// produce the same DataHash. This is NOT mathematically guaranteed by a simple TCP mesh!
	// If network delays cause envelopes to arrive out of order, nodes will cut blocks with different
	// DataHashes. BA* will reach consensus on only ONE hash. Nodes that cut a different block will not
	// have the data for the winning block and will be unable to write it to the ledger, wedging the chain.
	
	select {
	case c.txChan <- env:
		return nil
	case <-c.haltChan:
		return nil // shutdown
	}
}

// Configure accepts config transactions
func (c *Chain) Configure(configEnv *common.Envelope, configSeq uint64) error {
	select {
	case c.configChan <- configEnv:
		return nil
	case <-c.haltChan:
		return nil
	}
}

// WaitReady blocks until the chain is ready to accept messages
func (c *Chain) WaitReady() error {
	return nil
}

// Errored returns a channel which will close when an error occurs
func (c *Chain) Errored() <-chan struct{} {
	return c.errorChan
}

// Start boots the algorithm
func (c *Chain) Start() {
	if c.transport != nil {
		if err := c.transport.Start(); err != nil {
			fmt.Printf(">>> [ALGORAND BA*] Failed to start transport: %v\n", err)
		}
		c.wg.Add(1)
		go c.networkLoop()
	}

	c.wg.Add(1)
	go c.mainLoop()
}

func (c *Chain) networkLoop() {
	defer c.wg.Done()
	for {
		select {
		case <-c.haltChan:
			return
		case msg, ok := <-c.transport.Incoming():
			if !ok {
				return
			}
			if len(msg) < 1 {
				continue
			}
			msgType := msg[0]
			payload := msg[1:]

			if msgType == MsgTypeVote {
				vote, err := ba.DecodeVote(payload)
				if err == nil {
					c.inbox.Add(vote)
					if c.telemetry != nil {
						peerID := "unknown"
						var seats uint64
						if m, ok := c.registry.Lookup(vote.Voter); ok {
							peerID = m.ID
							tau := c.params.TauStep
							if vote.Step == ba.StepFinal {
								tau = c.params.TauFinal
							}
							role := vrf.Role{Name: "committee", Round: vote.Round, Step: vote.Step}
							seed := c.seedChain.Get(vote.Round, c.channelID)
							seats = vrf.VerifySort(vote.Voter, vote.SortHash, vote.SortProof, seed, tau, role, m.Stake, c.registry.TotalStake())
						}
						valStr := ""
						if len(vote.Value) >= 4 {
							valStr = fmt.Sprintf("%x", vote.Value[:4])
						}
						c.telemetry.RecordVote("recv", peerID, vote.Round, ba.StepName(vote.Step), valStr, seats)
					}
				}
			} else if msgType == MsgTypeProposal {
				var prop ProposalMsg
				if err := json.Unmarshal(payload, &prop); err == nil {
					fmt.Printf(">>> [ALGORAND BA*] Received ProposalMsg for round %d\n", prop.Round)
					select {
					case c.proposalChan <- prop:
					case <-c.haltChan:
					}
				} else {
					fmt.Printf(">>> [ALGORAND BA*] Failed to unmarshal ProposalMsg: %v\n", err)
				}
			} else if msgType == MsgTypeWakeup {
				if len(payload) == 8 {
					round := binary.BigEndian.Uint64(payload)
					c.Lock()
					currentRound := c.support.Height() + c.failedRounds
					c.Unlock()
					if round == currentRound {
						select {
						case c.wakeupChan <- struct{}{}:
						default:
						}
					} else {
						fmt.Printf(">>> [ALGORAND BA*] MsgTypeWakeup dropped: round %d != currentRound %d\n", round, currentRound)
					}
				}
			} else {
				fmt.Printf(">>> [ALGORAND BA*] Unknown message type: %d\n", msgType)
			}
		}
	}
}

// Halt shuts down the chain
func (c *Chain) Halt() {
	select {
	case <-c.haltChan:
		// already halted
	default:
		close(c.haltChan)
	}
	if c.transport != nil {
		c.transport.Close()
	}
	c.wg.Wait()
}

type pBatch struct {
	envs    []*common.Envelope
	retries int
	isConf  bool
}

func (c *Chain) mainLoop() {
	defer c.wg.Done()

	timer := time.NewTimer(c.params.LambdaBlock)
	var pending []pBatch

	for {
		var processChan <-chan time.Time
		if len(pending) > 0 {
			processChan = time.After(0)
		}

		select {
		case <-c.haltChan:
			return

		case configEnv := <-c.configChan:
			batch := c.support.BlockCutter().Cut()
			if len(batch) > 0 {
				pending = append(pending, pBatch{envs: batch})
			}
			pending = append(pending, pBatch{envs: []*common.Envelope{configEnv}, isConf: true})

		case env := <-c.txChan:
			batches, _ := c.support.BlockCutter().Ordered(env)
			for _, batch := range batches {
				pending = append(pending, pBatch{envs: batch})
			}

		case <-timer.C:
			batch := c.support.BlockCutter().Cut()
			if len(batch) > 0 {
				pending = append(pending, pBatch{envs: batch})
			}
			timer.Reset(c.params.LambdaBlock)

		case <-c.wakeupChan:
			c.proposeAndAgree(nil, false, nil, 0)
		case prop := <-c.proposalChan:
			c.Lock()
			currentRound := c.support.Height() + c.failedRounds
			c.Unlock()
			fmt.Printf(">>> [ALGORAND BA*] mainLoop processing ProposalMsg for round %d (my round: %d)\n", prop.Round, currentRound)
			if prop.Round == currentRound {
				c.proposeAndAgree(nil, false, &prop, 0)
			}

		case <-processChan:
			b := pending[0]
			pending = pending[1:]

			success, err := c.proposeAndAgree(b.envs, b.isConf, nil, b.retries)
			if err != nil {
				fmt.Printf(">>> [ALGORAND BA*] BA* failed: %v\n", err)
				success = false
			}

			if !success {
				b.retries++
				if b.retries >= 50 {
					fmt.Printf(">>> [ALGORAND BA*] Batch abandoned after 50 failed retries, chain returning to normal operation\n")
				} else {
					fmt.Printf(">>> [ALGORAND BA*] Re-queuing batch at the front (retry %d), rebuilding against current ledger height\n", b.retries)
					pending = append([]pBatch{b}, pending...)
					time.Sleep(1 * time.Second)
				}
			}
		}
	}
}

func (c *Chain) proposeAndAgree(batch []*common.Envelope, isConfig bool, firstProp *ProposalMsg, retryCount int) (bool, error) {
	c.Lock()
	baseHeight := c.support.Height()
	round := baseHeight + c.failedRounds
	roundStart := time.Now()
	c.Unlock()
	
	seed := c.seedChain.Get(round, c.channelID)

	// Broadcast wakeup so others join BA* if we are initiating it
	if firstProp == nil && len(batch) > 0 {
		wakeupMsg := make([]byte, 9)
		wakeupMsg[0] = MsgTypeWakeup
		binary.BigEndian.PutUint64(wakeupMsg[1:], round)
		c.transport.Broadcast(wakeupMsg)
	}

	var myBlock *common.Block
	var bestProp *ProposalMsg

	// 1. If we have a batch, try to be a proposer
	if len(batch) > 0 {
		myBlock = c.support.CreateNextBlock(batch)
		
		role := vrf.Role{Name: "proposer", Round: round, Step: uint64(retryCount)}
		member, ok := c.registry.Lookup(c.privKey.Public().(ed25519.PublicKey))
		if ok {
			hash, proof, j := vrf.Sortition(c.privKey, seed, c.params.TauProposer, role, member.Stake, c.registry.TotalStake())
			if j > 0 {
				priority := vrf.Priority(hash, j)
				blockBytes, _ := proto.Marshal(myBlock)
				
				myProp := &ProposalMsg{
					Round:      round,
					Step:       uint64(retryCount),
					PubKey:     c.privKey.Public().(ed25519.PublicKey),
					Priority:   priority,
					SortHash:   hash,
					Proof:      proof,
					BlockBytes: blockBytes,
				}
				bestProp = myProp
				
				// Broadcast our proposal
				fmt.Printf(">>> [ALGORAND BA*] I sent proposal %x at +%v\n", hash[:4], time.Since(roundStart))
				propBytes, _ := json.Marshal(myProp)
				c.transport.Broadcast(append([]byte{MsgTypeProposal}, propBytes...))
			}
		}
	}

	// 2. Add firstProp if it's valid
	verifyProp := func(prop *ProposalMsg) bool {
		if prop.Round != round {
			fmt.Printf(">>> [ALGORAND BA*] verifyProp failed: round %d != %d\n", prop.Round, round)
			return false
		}
		member, ok := c.registry.Lookup(ed25519.PublicKey(prop.PubKey))
		if !ok {
			fmt.Printf(">>> [ALGORAND BA*] verifyProp failed: unknown member\n")
			return false
		}
		role := vrf.Role{Name: "proposer", Round: round, Step: prop.Step}
		j := vrf.VerifySort(member.PK, prop.SortHash, prop.Proof, seed, c.params.TauProposer, role, member.Stake, c.registry.TotalStake())
		if j == 0 {
			fmt.Printf(">>> [ALGORAND BA*] verifyProp failed: VerifySort returned 0\n")
			return false
		}
		// Check priority calculation
		calcPri := vrf.Priority(prop.SortHash, j)
		if string(calcPri) != string(prop.Priority) {
			fmt.Printf(">>> [ALGORAND BA*] verifyProp failed: priority mismatch\n")
			return false
		}
		return true
	}

	if firstProp != nil && verifyProp(firstProp) {
		if bestProp == nil || string(firstProp.Priority) > string(bestProp.Priority) {
			bestProp = firstProp
		}
	}

	// 3. Wait LambdaPriority for other proposals
	timeout := time.After(c.params.LambdaPriority)
	adoptionDeadline := time.Now().Add(c.params.LambdaPriority)
waitLoop:
	for {
		select {
		case prop := <-c.proposalChan:
			recvTime := time.Now()
			fmt.Printf(">>> [ALGORAND BA*] waitLoop processing ProposalMsg for round %d\n", prop.Round)
			if verifyProp(&prop) {
				if bestProp == nil || string(prop.Priority) > string(bestProp.Priority) {
					// We need to copy prop since loop variable is overwritten
					propCopy := prop
					bestProp = &propCopy
					fmt.Printf(">>> [ALGORAND BA*] Proposal %x ADOPTED at +%v (deadline was +%v)\n", prop.SortHash[:4], recvTime.Sub(roundStart), adoptionDeadline.Sub(roundStart))
				}
			} else {
				fmt.Printf(">>> [ALGORAND BA*] ProposalMsg failed verifyProp!\n")
			}
		case <-timeout:
			break waitLoop
		case <-c.haltChan:
			return false, nil
		}
	}

	// 4. Decide on the block to agree on
	var blockHash []byte
	var finalBlock *common.Block

	// Get PrevHash using CreateNextBlock with no envs
	emptyBlockForHeader := c.support.CreateNextBlock(nil)

	if bestProp != nil {
		finalBlock = &common.Block{}
		if err := proto.Unmarshal(bestProp.BlockBytes, finalBlock); err == nil {
			blockHash = ba.HashBlock(finalBlock.Header.DataHash)
			fmt.Printf(">>> [ALGORAND BA*] Using blockHash from proposal: %x\n", blockHash)
		} else {
			fmt.Printf(">>> [ALGORAND BA*] Unmarshal failed: %v\n", err)
			blockHash = ba.EmptyBlockHash(round, emptyBlockForHeader.Header.PreviousHash)
			fmt.Printf(">>> [ALGORAND BA*] Using EmptyBlockHash (unmarshal failed): %x\n", blockHash)
		}
	} else {
		// Paper Section 6: If no proposal, fall back to empty block
		blockHash = ba.EmptyBlockHash(round, emptyBlockForHeader.Header.PreviousHash)
		fmt.Printf(">>> [ALGORAND BA*] Using EmptyBlockHash (no proposal): %x\n", blockHash)
	}

	ctx := &ba.Context{
		Round:    round,
		PrevHash: emptyBlockForHeader.Header.PreviousHash,
		Params:   c.params,
		Registry: c.registry,
		Seed:     seed,
	}

	start := time.Now()
	fmt.Printf(">>> [ALGORAND BA*] Starting BA* with blockHash=%x\n", blockHash)
	res, err := c.node.Run(ctx, blockHash)
	duration := time.Since(start)
	if err != nil {
		return false, err
	}

	success := (res.Outcome == ba.Final && !res.IsEmpty)
	emptyAgreed := (res.Outcome == ba.Tentative && res.IsEmpty)

	if success && finalBlock != nil {
		fmt.Printf(">>> [ALGORAND BA*] SUCCESS! Reached FINAL consensus on block %d! Writing to ledger...\n", finalBlock.Header.Number)
		metadata := []byte(fmt.Sprintf("round=%d,steps=%d", ctx.Round, res.Steps))

		// Check if it's a config block
		isConfigBlock := false
		if len(finalBlock.Data.Data) > 0 {
			env := &common.Envelope{}
			if err := proto.Unmarshal(finalBlock.Data.Data[0], env); err == nil && env.Payload != nil {
				payload := &common.Payload{}
				if err := proto.Unmarshal(env.Payload, payload); err == nil && payload.Header != nil && payload.Header.ChannelHeader != nil {
					ch := &common.ChannelHeader{}
					if err := proto.Unmarshal(payload.Header.ChannelHeader, ch); err == nil {
						isConfigBlock = (ch.Type == int32(common.HeaderType_CONFIG) || ch.Type == int32(common.HeaderType_CONFIG_UPDATE))
					}
				}
			}
		}

		if isConfigBlock {
			c.support.WriteConfigBlock(finalBlock, metadata)
		} else {
			c.support.WriteBlock(finalBlock, metadata)
		}
		
		c.Lock()
		// We NEVER reset failedRounds. It tracks total failed rounds over the lifetime.
		// If we reset it, round (Height + failedRounds) might decrease or stay the same.
		// c.failedRounds = 0 
		c.Unlock()
	} else if emptyAgreed {
		fmt.Printf(">>> [ALGORAND BA*] Agreed on EMPTY block for round %d. Incrementing failedRounds.\n", ctx.Round)
		c.Lock()
		c.failedRounds++
		c.Unlock()
	} else {
		fmt.Printf(">>> [ALGORAND BA*] Round %d did not reach consensus (outcome=%v, empty=%v).\n", ctx.Round, res.Outcome, res.IsEmpty)
	}

	if c.telemetry != nil {
		c.telemetry.SetLedgerHeight(c.support.Height())
		c.telemetry.RecordRound(ctx.Round, res.Steps, res.Outcome.String(), len(batch), int64(duration/time.Millisecond), res.SeatsWon)
	}

	// A5: Prune unconditionally on EVERY completed round
	c.inbox.Prune(round)

	return success, nil
}

// Broadcast implements the ba.Network interface
func (c *Chain) Broadcast(msg []byte) error {
	// Loopback our own votes locally
	if vote, err := ba.DecodeVote(msg); err == nil {
		c.inbox.Add(vote)
		if c.telemetry != nil {
			valStr := ""
			if len(vote.Value) >= 4 {
				valStr = fmt.Sprintf("%x", vote.Value[:4])
			}
			c.telemetry.RecordVote("sent", "", vote.Round, ba.StepName(vote.Step), valStr, 0)
		}
	}
	if c.transport != nil {
		return c.transport.Broadcast(append([]byte{MsgTypeVote}, msg...))
	}
	return nil
}
